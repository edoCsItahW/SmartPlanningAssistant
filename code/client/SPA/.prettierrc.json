{
    "$schema": "https://json.schemastore.org/prettierrc",
    "experimentalTernaries": true,
    "printWidth": 200,                    // 对应 ColumnLimit: 200
    "tabWidth": 4,                        // 对应 TabWidth: 4
    "useTabs": false,                     // 对应 UseTab: Never
    "semi": true,                         // 对应 RemoveSemicolon: false (实际是保留分号)
    "singleQuote": false,                 // LLVM 风格通常使用双引号
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "none",              // 对应 Cpp11BracedListStyle: true
    "bracketSpacing": true,               // 对应 SpacesInContainerLiterals: false
    "bracketSameLine": true,              // 对应 BreakBeforeBraces: Attach
    "arrowParens": "avoid",               // 单参数箭头函数省略括号
    "rangeStart": 0,
    "proseWrap": "preserve",
    "htmlWhitespaceSensitivity": "css",
    "vueIndentScriptAndStyle": true,      // Vue 文件中的 script 和 style 标签缩进
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": false,

    // 基于 clang-format 的额外配置
    "overrides": [
        {
            "files": ["*.vue", "*.html"],
            "options": {
                "htmlWhitespaceSensitivity": "ignore"
            }
        },
        {
            "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
            "options": {
                "trailingComma": "none"
            }
        }
    ]
}